POSTGRES_DB=officelab
POSTGRES_USER=officelab
POSTGRES_PASSWORD=            # openssl rand -base64 24

# Para propdb.py y (en Fase 2) la API. Desde el host del VPS o por túnel SSH:
DATABASE_URL=postgresql://officelab:CONTRASEÑA@127.0.0.1:5432/officelab

# 0 mientras se prueba por HTTP plano; 1 en cuanto Caddy sirva HTTPS (Fase 3).
# Con 1, el navegador NO manda la cookie de sesión sobre http:// y el login "no pega".
COOKIE_SECURE=0
