# Sirve el dashboard y hace de puerta a la API. La raíz es web/, nunca el repo:
# con root en el repo, /vps/.env quedaría descargable desde internet.
:80 {
	encode gzip

	# Cabeceras de seguridad. Se aplican a todo, incluida la API.
	header {
		# El tablero no carga scripts de terceros y no tiene ni un <script> inline
		# ni un onclick=, así que script-src puede ser estricto de verdad.
		# 'unsafe-inline' en style-src sí hace falta: app.js pinta el color de
		# estado con atributos style= en cada tarjeta.
		# img-src abierto a https: porque las fotos vienen de los cinco portales.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		# frame-ancestors ya lo cubre en navegadores actuales; esto es para los viejos.
		X-Frame-Options "DENY"
		# El token de recuperación viaja en la URL: sin esto se filtraría en el
		# Referer al cargar las fuentes de Google desde update-password.html?t=…
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		# No anunciar el stack: no es una defensa, pero tampoco hay que regalarlo.
		-Server
		-X-Powered-By
	}

	handle /api/* {
		# Las respuestas de la API son por usuario: que no las guarde ningún caché.
		header Cache-Control "no-store"
		reverse_proxy api:8000
	}

	handle {
		root * /srv/site

		# `no-cache` no significa "no guardes": significa "pregunta antes de usar".
		# Con el ETag que ya manda `file_server`, esa pregunta se contesta con un
		# 304 sin cuerpo, así que cuesta un viaje y cero bytes.
		#
		# Hace falta porque sin `Cache-Control` el navegador aplica caché
		# HEURÍSTICA: se inventa una frescura de ~10% de la edad del archivo y no
		# revalida. Un archivo que lleva una semana sin tocarse se queda cacheado
		# horas. El 2026-09-21 eso sirvió un `api.js` viejo después de desplegar y
		# la página reventó con "API.pdfAnalisis is not a function", con el archivo
		# nuevo ya en el disco del servidor.
		#
		# Ojo con verificar esto en un navegador automatizado: abre con caché
		# vacía y nunca reproduce el problema.
		header Cache-Control "no-cache"

		file_server
	}

	log {
		output file /var/log/caddy/access.log
		format console
	}
}

# Cuando haya dominio, esto reemplaza al bloque `:80` de arriba y Caddy saca el
# certificado solo. Falta además: COOKIE_SECURE=1 en vps/.env, BASE_URL con el
# dominio, y añadir a la cabecera
#   Strict-Transport-Security "max-age=31536000; includeSubDomains"
# que hoy sería mentira: sin TLS, el navegador no podría volver a entrar.
